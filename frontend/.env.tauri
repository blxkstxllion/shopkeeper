# Used only by `npm run build:tauri` (Vite's --mode tauri), never by the Docker/nginx build.
# The bundled desktop app has no reverse proxy in front of it, so this must be an absolute URL,
# unlike the containerized build's relative VITE_API_BASE_URL=/api (see frontend/Dockerfile).
VITE_API_BASE_URL=https://app.omnifixlabs.com/api
