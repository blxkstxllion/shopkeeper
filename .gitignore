# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
# Scoped to frontend/ (Vite's own .env.local convention) - a bare "*.local" matches any path
# *component*, not just a file extension, so it silently ignored the entire backend/src/
# ShopKeeper.Api.Local/ project (the offline edition's sidecar) until caught here.
frontend/*.local
.env
.env.*
!.env.example
!frontend/.env.development
!frontend/.env.tauri
!frontend/.env.offline

# --- .NET / Backend ---
backend/**/bin/
backend/**/obj/
backend/**/*.user
*.suo
*.userosscache
*.sln.docstates

# --- Logs ---
*.log
npm-debug.log*

# --- OS / Editor ---
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# --- Uploaded / local storage ---
backend/**/App_Data/uploads/

# --- Playwright MCP (screenshots/snapshots dropped in the repo root during manual QA) ---
.playwright-mcp/
