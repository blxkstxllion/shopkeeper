# Copy to .env and fill in real values. .env is git-ignored - never commit it.
# Used by `docker compose --env-file .env -f docker/docker-compose.yml -f docker/docker-compose.<env>.yml up`.

# ============================================================================
# Required in every environment
# ============================================================================

# PostgreSQL credentials. The database name/user/password the `postgres`
# container initializes with, and what the API's connection string uses.
POSTGRES_USER=shopkeeper
POSTGRES_PASSWORD=change-me
POSTGRES_DB=shopkeeper

# Symmetric signing key for JWT access tokens. Generate a real one with:
#   openssl rand -base64 48
# Minimum 32 bytes once UTF8-encoded. Rotating this invalidates every issued
# access token immediately (refresh tokens are stored hashed and unaffected).
JWT_SECRET=change-me-to-a-real-random-secret-at-least-32-bytes
JWT_ISSUER=ShopKeeper
JWT_AUDIENCE=ShopKeeperClient

# Origin the API's CORS policy allows. In production this should be the
# frontend's real public URL (e.g. https://app.yourdomain.com); in the
# containerized dev/prod stacks the frontend proxies /api itself, so CORS
# isn't actually exercised, but the API still requires the setting.
CORS_ALLOWED_ORIGIN=http://localhost:5173

# ============================================================================
# Local development only (docker-compose.dev.yml)
# ============================================================================

# What the frontend's Vite dev server (running outside Nginx) calls directly.
VITE_API_BASE_URL=http://localhost:8080/api

# ============================================================================
# Staging / production only (docker-compose.prod.yml)
# ============================================================================

# Your GHCR namespace - typically your GitHub username or org. Determines
# where images are pulled from: ghcr.io/$IMAGE_OWNER/shopkeeper-api:$API_IMAGE_TAG
IMAGE_OWNER=your-github-username

# Immutable tags only - never "latest" for a real deployment. staging.yml
# produces sha-<commit> tags; production.yml promotes one of those to a
# semver tag (vX.Y.Z) or main-<commit>. See .github/workflows/*.yml.
API_IMAGE_TAG=sha-0000000
FRONTEND_IMAGE_TAG=sha-0000000

# The public domain this deployment serves - caddy automatically obtains and
# renews a Let's Encrypt certificate for it, and it doubles as the base URL
# used to build links in outbound emails (password reset, invites). DNS for
# this domain must already point at the host before caddy starts, or
# certificate issuance fails.
DOMAIN=app.yourdomain.com

# Contact address Let's Encrypt uses for expiry/problem notices about the
# certificate above - not shown to end users.
ACME_EMAIL=ops@yourdomain.com

# Real transactional email (password reset, business invites) via AWS SES.
# Setting EMAIL_FROM_ADDRESS is what switches the API off the dev-only
# LoggingEmailSender - see backend/src/ShopKeeper.Infrastructure/DependencyInjection.cs.
# Must be a verified SES sender identity/domain in AWS_REGION. AWS credentials
# are deliberately NOT configured here - the API resolves them via the EC2
# instance role attached to the host (see README's deployment section), not
# a static access key, so there's no AWS secret to manage in this file at all.
EMAIL_FROM_ADDRESS=no-reply@yourdomain.com
EMAIL_FROM_NAME=The Shop Keeper
AWS_REGION=us-east-1

# Where nightly database backups (scripts/backup-db.sh) are uploaded. The
# bucket must exist already; the host's IAM instance role needs s3:PutObject
# on it (write-only - see database/backup-restore.md for the exact policy and
# the lifecycle rule that handles retention).
BACKUP_S3_BUCKET=your-backup-bucket-name

# Real Paystack subscription billing. Setting PAYSTACK_SECRET_KEY is what
# switches the API off today's fully self-serve plan changes - see
# backend/src/ShopKeeper.Infrastructure/DependencyInjection.cs and
# SetPlanTierCommand. Leave unset to keep the current free/self-serve
# behavior (every dev/CI environment today).
#
# The 4 PLN_xxx codes below are created BY HAND in the Paystack dashboard -
# one Plan per paid tier - not bootstrapped by this app. Get PAYSTACK_SECRET_KEY
# from Settings -> API Keys & Webhooks in your Paystack dashboard (test-mode
# keys are free and available immediately after signup; live keys require
# completing business verification).
PAYSTACK_SECRET_KEY=
PAYSTACK_BUSINESS_PLAN_CODE=
PAYSTACK_BUSINESS_AI_PLAN_CODE=
PAYSTACK_ENTERPRISE_PLAN_CODE=
PAYSTACK_ENTERPRISE_AI_PLAN_CODE=

# ============================================================================
# GitHub Actions only - set as repository/environment Variables & Secrets,
# never as literal values in a file. Listed here so it's documented in one
# place what CI/CD actually needs.
# ============================================================================

# Settings -> Environments -> staging / production -> Variables:
#   STAGING_HOST / PRODUCTION_HOST         the deploy target's hostname or IP
#   STAGING_SSH_USER / PRODUCTION_SSH_USER the SSH user to deploy as
#
# Settings -> Environments -> staging / production -> Secrets:
#   STAGING_SSH_KEY / PRODUCTION_SSH_KEY   private key for the above user
#
# GITHUB_TOKEN (pushing to GHCR) is provided automatically by GitHub Actions -
# nothing to configure.
#
# Until STAGING_HOST/PRODUCTION_HOST are set, the deploy jobs in staging.yml
# and production.yml intentionally skip (not fail) - see those files.
